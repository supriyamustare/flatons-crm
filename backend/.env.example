# Copy this file to .env and fill in real values.
# .env is ignored by git — NEVER commit real secrets.

# development | production | test
ENVIRONMENT=development

# Server: postgresql+asyncpg://crmuser:<password>@localhost/flatons_crm
# Local Docker dev: postgresql+asyncpg://crmuser:devpassword@localhost/flatons_crm
DATABASE_URL=postgresql+asyncpg://crmuser:CHANGE_ME@localhost/flatons_crm

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_generate_a_64_character_random_string_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

REDIS_URL=redis://localhost:6379/0
# Leave empty to use REDIS_URL
CELERY_BROKER_URL=

# Uploaded and generated documents
FILE_STORAGE_PATH=/var/crm/documents

# Comma-separated frontend URLs allowed to call the API (CORS)
ALLOWED_ORIGINS=http://localhost:5173

# Email (used from Phase 4)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
